<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- HTTP permitido para servidor de sincronización en red local (http://192.168.x.x:8787) -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
