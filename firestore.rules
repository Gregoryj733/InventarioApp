rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inventario_products/{productId} {
      allow read, write: if true;
    }
    match /inventario_sales/{saleId} {
      allow read, write: if true;
    }
    match /inventario_meta/{docId} {
      allow read, write: if true;
    }
  }
}
